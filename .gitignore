# The suite itself has no dependencies and no build step — nothing here is
# required to run it. This is only what `npm install playwright` leaves behind
# when you run the browser tests (test/forms.js, test/alignment.js), which is
# a local dev tool, not part of the app. See README, "No dependencies".
node_modules/
package.json
package-lock.json

# Coach Mode (D-339): a client's numbers never enter this public repository.
# Sealed client backups, all-client backups and session recaps are made on
# the coach's device and stay there. test/coach-checks.js also fails if any
# tracked file carries the coach export signature.
money-rooms-coach-*
money-rooms-recap-*
*.coach.json

# Safeword (D-340): a person's backup file never enters this public repository.
safeword-backup-*
