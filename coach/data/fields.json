{
  "id": "coach_fields",
  "version": "2026.1",
  "asOf": "2026-09-25",
  "source": "Coach Mode's entry forms (CD-003). Each id is the SPARKS Ledger row of the same name (data/ledger-rows.json), written to the same place in the household, so a client file could one day open in SPARKS unchanged.",
  "confidence": "convention",
  "confidenceNote": "A list of questions and where their answers live, not a figure. coach/shared/fields.js writes each one; nothing here is a number.",
  "note": "unit: cents (per says month or year), rate (a fraction, typed as a percent), date, bool, count, enum (choices), text, match (two percents). list: debt | asset | goal for one-line-per-item fields; their item keys are the field ids below.",
  "fields": {
    "dob": { "label": "Date of birth", "unit": "date" },
    "dependents": { "label": "People who depend on this income", "unit": "count" },
    "grossAnnualIncome": { "label": "Pay before tax, a year", "unit": "cents", "per": "year" },
    "takeHomeMonthly": { "label": "Take-home pay, a month", "unit": "cents", "per": "month" },
    "payVaries": { "label": "Pay swings month to month", "unit": "bool" },
    "accommodationMonthly": { "label": "Rent or mortgage, a month", "unit": "cents", "per": "month" },
    "foodMonthly": { "label": "Food, a month", "unit": "cents", "per": "month" },
    "transportationMonthly": { "label": "Getting around, a month", "unit": "cents", "per": "month" },
    "wantsMonthly": { "label": "Everything else, a month", "unit": "cents", "per": "month" },
    "hasDebt": { "label": "Any debt at all", "unit": "bool" },
    "cashSavings": { "label": "Cash and savings (one total)", "unit": "cents" },
    "investments": { "label": "Investments and retirement (one total)", "unit": "cents" },
    "highestDeductible": { "label": "Highest insurance deductible", "unit": "cents" },
    "termLife": { "label": "Term life cover in force", "unit": "cents" },
    "disabilityMonthly": { "label": "Disability benefit if unable to work, a month", "unit": "cents", "per": "month" },
    "employerMatch": { "label": "Employer match", "unit": "match" },
    "contributionPercent": { "label": "Retirement contribution, share of pay", "unit": "rate" },
    "filingStatus": { "label": "Filing status", "unit": "enum", "choices": [["single", "Single"], ["married_joint", "Married, filing jointly"], ["married_separate", "Married, filing separately"], ["head_of_household", "Head of household"]] },
    "state": { "label": "State (two letters)", "unit": "text" },
    "marginalRate": { "label": "Marginal tax rate", "unit": "rate" },
    "debtLabel": { "label": "What it is", "unit": "text", "list": "debt" },
    "debtType": { "label": "Kind", "unit": "enum", "list": "debt", "choices": [["credit_card", "Credit card"], ["student_loan", "Student loan"], ["auto", "Car loan"], ["mortgage", "Mortgage"], ["personal", "Personal loan"], ["medical", "Medical"], ["family", "Owed to family"], ["other", "Other"]] },
    "debtBalance": { "label": "Still owed", "unit": "cents", "list": "debt" },
    "debtRate": { "label": "Interest rate", "unit": "rate", "list": "debt" },
    "debtMinPayment": { "label": "Minimum, a month", "unit": "cents", "per": "month", "list": "debt" },
    "assetLabel": { "label": "Account", "unit": "text", "list": "asset" },
    "assetAccountType": { "label": "Kind", "unit": "enum", "list": "asset", "choices": [["checking", "Checking"], ["savings", "Savings"], ["hysa", "High-yield savings"], ["brokerage", "Brokerage (taxable)"], ["401k", "401(k)"], ["roth_401k", "Roth 401(k)"], ["403b", "403(b)"], ["traditional_ira", "Traditional IRA"], ["roth_ira", "Roth IRA"], ["hsa", "HSA"], ["crypto", "Crypto"], ["other", "Other"]] },
    "assetValue": { "label": "In it now", "unit": "cents", "list": "asset" },
    "goalName": { "label": "Goal", "unit": "text", "list": "goal" },
    "goalDate": { "label": "By", "unit": "date", "list": "goal" },
    "goalAmount": { "label": "Costs", "unit": "cents", "list": "goal" },
    "goalSaved": { "label": "Saved so far", "unit": "cents", "list": "goal" },
    "goalMonthly": { "label": "Going in, a month", "unit": "cents", "per": "month", "list": "goal" }
  },
  "lists": {
    "debt": { "label": "Debts", "add": "Add a debt", "fields": ["debtLabel", "debtType", "debtBalance", "debtRate", "debtMinPayment"] },
    "asset": { "label": "Accounts", "add": "Add an account", "fields": ["assetLabel", "assetAccountType", "assetValue"] },
    "goal": { "label": "Goals", "add": "Add a goal", "fields": ["goalName", "goalDate", "goalAmount", "goalSaved", "goalMonthly"] }
  }
}
