{
 "id": "moons",
 "version": "1.0",
 "asOf": "2026-09-20",
 "source": "The Solar System master prompt (docs/SOLAR-SYSTEM.md), Part 1 section 1.10 and Part 2 section A8.",
 "confidence": "convention",
 "confidenceNote": "Strategy tracks, not facts. A moon reads levels and metrics and writes only through a level edit the person confirms or to the scenario block layer.",
 "note": "unlockWhen, dimWhen and outgrownWhen are gates in the grammar described in gateGrammar, evaluated by the engine; every id they name must resolve (lint). intake questions are stored in the moon's own store and never duplicate a level field (lint). moves resolve in data/moves.json; rooms are registry ids. States: dim, open, active, settled, outgrown. A dim moon is never hidden and never blocks entry.",
 "gateGrammar": {
  "always": "{\"always\": true}",
  "all": "{\"all\": [gate, ...]}",
  "any": "{\"any\": [gate, ...]}",
  "not": "{\"not\": gate}",
  "held": "{\"held\": \"A4\"}: the level has a value (a number, a none or a rough; unknown does not count)",
  "value": "{\"value\": \"D1\", \"op\": \"gt\"|\"gte\"|\"lt\"|\"lte\"|\"eq\", \"than\": n}: the level's primary number against a constant",
  "answer": "{\"answer\": \"Y27\", \"key\": \"relocateOk\", \"is\": true|\"value\"|\"any\"} or with op/than: one field of a level's answer",
  "metric": "{\"metric\": \"highInterestFlag\", \"state\": \"on\"|\"off\"|\"rough\"|\"sharp\"|\"earned\"|\"locked\"} or with op/than",
  "moon": "{\"moon\": \"mainPath\", \"state\": \"settled\"}",
  "moonStep": "{\"moonStep\": \"mainPath\", \"reached\": \"investing\"}",
  "asked": "{\"asked\": true}: the person tapped the moon open"
 },
 "states": [
  "dim",
  "open",
  "active",
  "settled",
  "outgrown"
 ],
