{
  "id": "move",
  "title": "Moving somewhere else",
  "blurb": "A city's cost of living against where you are, the state-tax line each side, and what the move itself costs.",
  "version": "1.0",
  "asOf": "2026-01-01",
  "source": "An invented what-if template (D-086): its questions and defaults are conventions chosen for this app, not measurements; every reference figure it draws on names its own data/ file and source.",
  "confidence": "unverified",
  "drawsOn": [
    "monthlyExpenses",
    "grossAnnualIncome",
    "state",
    "filingStatus",
    "cashSavings"
  ],
  "questions": [
    {
      "id": "fromCity",
      "ask": "Where you are (nearest listed city)",
      "default": "national",
      "choicesFrom": {
        "table": "colIndex",
        "path": [
          "cities"
        ],
        "label": "label",
        "first": [
          {
            "id": "national",
            "label": "Not listed, national average"
          }
        ]
      }
    },
    {
      "id": "toCity",
      "ask": "Where you would go",
      "default": "raleigh",
      "choicesFrom": {
        "table": "colIndex",
        "path": [
          "cities"
        ],
        "label": "label"
      }
    },
    {
      "id": "band",
      "ask": "How far",
      "default": "regional",
      "choicesFrom": {
        "table": "movingCost",
        "path": [
          "bands"
        ],
        "label": "label"
      }
    },
    {
      "id": "startsOn",
      "ask": "Moving in how many months?",
      "unit": "months",
      "default": 3,
      "min": 0,
      "max": 36
    }
  ],
  "startsOn": "@startsOn",
  "gapMonths": 0,
  "diff": {
    "income": [],
    "expenses": [
      {
        "label": "A month scaled by the cost-of-living ratio",
        "from": 0,
        "months": null,
        "multiplier": {
          "/": [
            {
              "table": "colIndex",
              "path": [
                "cities",
                "@toCity",
                "index"
              ]
            },
            {
              "coalesce": [
                {
                  "table": "colIndex",
                  "path": [
                    "cities",
                    "@fromCity",
                    "index"
                  ]
                },
                {
                  "table": "colIndex",
                  "path": [
                    "national"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "label": "State income tax, the difference a month",
        "from": 0,
        "months": null,
        "addCents": {
          "round": {
            "/": [
              {
                "-": [
                  {
                    "fn": "stateTaxAnnual",
                    "args": {
                      "state": {
                        "table": "colIndex",
                        "path": [
                          "cities",
                          "@toCity",
                          "state"
                        ]
                      },
                      "grossAnnualCents": "$grossAnnualCents"
                    }
                  },
                  {
                    "fn": "stateTaxAnnual",
                    "args": {
                      "state": "$state",
                      "grossAnnualCents": "$grossAnnualCents"
                    }
                  }
                ]
              },
              12
            ]
          }
        }
      }
    ],
    "oneTime": [
      {
        "label": "The move itself",
        "when": 0,
        "cents": {
          "table": "movingCost",
          "path": [
            "bands",
            "@band",
            "cents"
          ]
        }
      }
    ],
    "assets": []
  },
  "lines": [
    {
      "id": "ratio",
      "label": "Cost of living there, against here",
      "unit": "percent",
      "value": {
        "-": [
          {
            "/": [
              {
                "table": "colIndex",
                "path": [
                  "cities",
                  "@toCity",
                  "index"
                ]
              },
              {
                "coalesce": [
                  {
                    "table": "colIndex",
                    "path": [
                      "cities",
                      "@fromCity",
                      "index"
                    ]
                  },
                  {
                    "table": "colIndex",
                    "path": [
                      "national"
                    ]
                  }
                ]
              }
            ]
          },
          1
        ]
      },
      "note": "The index ratio less one: +20% means a month costs a fifth more."
    },
    {
      "id": "monthDelta",
      "label": "The same month, there",
      "unit": "dollarsMonthly",
      "value": {
        "round": {
          "*": [
            "$monthlyExpensesCents",
            {
              "+": [
                1,
                "^ratio"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "stateNow",
      "label": "State income tax here, a year",
      "unit": "dollars",
      "value": {
        "fn": "stateTaxAnnual",
        "args": {
          "state": "$state",
          "grossAnnualCents": "$grossAnnualCents"
        }
      }
    },
    {
      "id": "stateThere",
      "label": "State income tax there, a year",
      "unit": "dollars",
      "value": {
        "fn": "stateTaxAnnual",
        "args": {
          "state": {
            "table": "colIndex",
            "path": [
              "cities",
              "@toCity",
              "state"
            ]
          },
          "grossAnnualCents": "$grossAnnualCents"
        }
      }
    },
    {
      "id": "moveCost",
      "label": "The move",
      "unit": "dollars",
      "value": {
        "table": "movingCost",
        "path": [
          "bands",
          "@band",
          "cents"
        ]
      }
    }
  ],
  "protect": [
    "The job, or an offer in hand before the lease is signed",
    "The cushion after the move"
  ],
  "cut": [],
  "tripleD": {},
  "outputs": [
    "netWorthAtEndCents",
    "fiDateShiftMonths"
  ],
  "horizonMonths": 120,
  "sources": [
    "data/col_index.json",
    "data/moving_cost.json",
    "data/state_brackets_2026.json",
    "data/federal_brackets_2026.json",
    "data/triple_d.json",
    "data/return_bands.json"
  ],
  "note": "A question may say choicesFrom instead of choices: {table, path, label, first}. The choices are read from that reference table when the template loads (Events.resolveChoices), so the template keeps no copy of forty cities that data/col_index.json owns. D-297."
}
