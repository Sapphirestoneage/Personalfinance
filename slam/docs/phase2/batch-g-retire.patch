-const DAY = 86400000;
-const PER_YEAR = { weekly: 52, biweekly: 26, semimonthly: 24, monthly: 12 };
-const STEP_DAYS = { weekly: 7, biweekly: 14 };
-const COUNTS = new Set(['spend', 'fee', 'refund', 'reimbursement']);
-const r2 = (x) => Math.round(x * 100) / 100 + 0;
