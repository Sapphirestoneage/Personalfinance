  "gapMonths": 0,
  "diff": {
    "income": [],
    "expenses": [
      {
        "label": "A month scaled by the cost-of-living ratio",
        "from": 0,
        "months": null,
        "multiplier": {
          "/": [
            {
              "table": "colIndex",
              "path": [
                "cities",
                "@toCity",
                "index"
              ]
            },
            {
              "coalesce": [
                {
                  "table": "colIndex",
                  "path": [
                    "cities",
                    "@fromCity",
                    "index"
                  ]
                },
                {
                  "table": "colIndex",
                  "path": [
                    "national"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "label": "State income tax, the difference a month",
        "from": 0,
        "months": null,
        "addCents": {
          "round": {
            "/": [
              {
                "-": [
                  {
                    "fn": "stateTaxAnnual",
                    "args": {
                      "state": {
                        "table": "colIndex",
                        "path": [
                          "cities",
                          "@toCity",
                          "state"
                        ]
                      },
                      "grossAnnualCents": "$grossAnnualCents"
                    }
                  },
                  {
                    "fn": "stateTaxAnnual",
                    "args": {
                      "state": "$state",
                      "grossAnnualCents": "$grossAnnualCents"
                    }
                  }
                ]
              },
              12
            ]
          }
        }
      }
    ],
    "oneTime": [
      {
        "label": "The move itself",
        "when": 0,
        "cents": {
          "table": "movingCost",
          "path": [
            "bands",
            "@band",
            "cents"
          ]
        }
      }
    ],
    "assets": []
  },
  "lines": [
    {
      "id": "ratio",
      "label": "Cost of living there, against here",
      "unit": "percent",
      "value": {
        "-": [
          {
            "/": [
              {
                "table": "colIndex",
                "path": [
                  "cities",
                  "@toCity",
                  "index"
                ]
              },
              {
                "coalesce": [
                  {
                    "table": "colIndex",
                    "path": [
                      "cities",
                      "@fromCity",
                      "index"
                    ]
                  },
                  {
                    "table": "colIndex",
                    "path": [
                      "national"
                    ]
                  }
                ]
              }
            ]
          },
          1
        ]
      },
      "note": "The index ratio less one: +20% means a month costs a fifth more."
    },
    {
      "id": "monthDelta",
      "label": "The same month, there",
      "unit": "dollarsMonthly",
      "value": {
        "round": {
          "*": [
            "$monthlyExpensesCents",
            {
              "+": [
                1,
                "^ratio"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "stateNow",
      "label": "State income tax here, a year",
      "unit": "dollars",
      "value": {
        "fn": "stateTaxAnnual",
        "args": {
          "state": "$state",
          "grossAnnualCents": "$grossAnnualCents"
        }
      }
    },
    {
      "id": "stateThere",
      "label": "State income tax there, a year",
      "unit": "dollars",
      "value": {
        "fn": "stateTaxAnnual",
        "args": {
          "state": {
            "table": "colIndex",
            "path": [
              "cities",
              "@toCity",
              "state"
            ]
          },
          "grossAnnualCents": "$grossAnnualCents"
        }
      }
    },
    {
      "id": "moveCost",
      "label": "The move",
      "unit": "dollars",
      "value": {
        "table": "movingCost",
        "path": [
          "bands",
          "@band",
          "cents"
        ]
      }
    }
  ],
  "protect": [
    "The job, or an offer in hand before the lease is signed",
    "The cushion after the move"
  ],
  "cut": [],
  "tripleD": {},
  "outputs": [
    "netWorthAtEndCents",
    "fiDateShiftMonths"
  ],
  "horizonMonths": 120,
  "sources": [
    "data/col_index.json",
    "data/moving_cost.json",
    "data/state_brackets_2026.json",
    "data/federal_brackets_2026.json",
    "data/triple_d.json",
